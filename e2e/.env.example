# URL do frontend (Vite dev server) usada pelos testes de UI
FRONTEND_URL=http://localhost:5173

# URL base da API (.NET) usada pelos testes de API
API_URL=http://localhost:5064

# Quando "true", o Playwright inicia automaticamente o frontend (npm run dev)
# antes dos testes de UI. Desative se você já for iniciá-lo manualmente.
WEB_SERVER_AUTOSTART=true
