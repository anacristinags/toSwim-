{
  "name": "toswim-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "Testes end-to-end (UI) e de API do toSwim com Playwright",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=web",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=web --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "codegen": "playwright codegen http://localhost:5173"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.13.3"
  }
}
